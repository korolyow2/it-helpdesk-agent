    {
      "id": "M01",
      "kind": "model",
      "category": "tool_selection",
      "user_id": "user-001",
      "messages": [
        "Read TKT-001 and tell me its current status."
      ],
      "expected": {
        "read_ids": [
          "TKT-001"
        ],
        "answer_terms": [
          "open"
        ],
        "no_search": true
      }
    },

# Local demo credentials. Replace every placeholder; never reuse MCP tokens at the mock.
MOCK_DATABASE=data/runtime/helpdesk.sqlite3
MOCK_SERVICE_KEY=replace-with-a-random-service-key
MOCK_USER_TOKENS='{"replace-with-alice-token":"user-001","replace-with-ben-token":"user-002","replace-with-sam-token":"user-003","replace-with-dana-token":"user-004"}'
MOCK_API_URL=http://127.0.0.1:8001
MCP_USER_TOKENS='{"replace-with-alice-mcp-token":"user-001","replace-with-ben-mcp-token":"user-002","replace-with-sam-mcp-token":"user-003","replace-with-dana-mcp-token":"user-004"}'

# Read-only streaming agent. A real run requires a valid Anthropic API key.
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-sonnet-5-5
ANTHROPIC_API_KEY=replace-with-an-anthropic-api-key
# Required only for a key that is not scoped to one workspace.
ANTHROPIC_WORKSPACE_ID=
MCP_URL=http://127.0.0.1:8002/mcp
AGENT_DATABASE=data/runtime/agent.sqlite3

# Local Langfuse. Generate real local project credentials with scripts/init_langfuse.py.
HELPDESK_TRACING_ENABLED=false
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=replace-with-local-project-public-key
LANGFUSE_SECRET_KEY=replace-with-local-project-secret-key
LANGFUSE_TRACING_ENVIRONMENT=development
HELPDESK_RELEASE=local
FASTMCP_TELEMETRY_MODE=propagation_only

# Offline evaluation judge; independent invocation, same-family bias applies.
JUDGE_MODEL=claude-opus-5-5

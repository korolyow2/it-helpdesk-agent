---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	guardrail(guardrail)
	agent(agent)
	blocked(blocked)
	__end__([<p>__end__</p>]):::last
	__start__ --> guardrail;
	guardrail -. &nbsp;helpdesk&nbsp; .-> agent;
	guardrail -.-> blocked;
	agent --> __end__;
	blocked --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
